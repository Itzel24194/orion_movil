{
  "expo": {
    "name": "ORIONSTOREE",
    "slug": "ORIONSTOREE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acceso a la cámara para probar productos / Allow camera access to try on products",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-video",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.itzel23456.ORIONSTOREE",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/images/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "e53f4ead-910e-4214-90c4-d879a6464828"
      }
    }
  }
}
